# Apple Ads Platform API Credentials
# Get these from: Apple Ads > Account Settings > API
APPLE_ADS_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_TEAM_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Paste your EC private key (PEM format) as a single line with \n for newlines
# Or place private-key.pem in the project root and leave this empty
APPLE_ADS_PRIVATE_KEY=
